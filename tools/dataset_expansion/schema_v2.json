{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"MoTE shared text SFT JSONL v2",
 "type":"object",
 "required":["schema_version","id","problem_id","family_id","input","output","messages","final","domain","source","source_revision","source_split","license","split","quality_level","quality_tier","release_status","verification","review_flags","provenance","metadata","response_mode","assistant_loss_mask","record_content_sha256"],
 "properties":{
  "schema_version":{"const":"mote-sft-jsonl-2.0"},
  "id":{"type":"string","minLength":1},
  "problem_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "family_id":{"type":"string","minLength":1},
  "input":{"type":["string","null"]},
  "output":{"type":["string","null"]},
  "messages":{"type":"array","minItems":1,"items":{"type":"object","required":["role","content"],"properties":{"role":{"type":"string"},"content":{"type":["string","array","null"]},"reasoning_content":{"type":["string","null"]}},"additionalProperties":true}},
  "assistant_loss_mask":{"type":"array","items":{"type":"boolean"}},
  "final":{"type":"string"},
  "solution":{"type":["string","null"]},
  "domain":{"type":"string"},
  "source":{"type":"string"},
  "source_revision":{"type":["string","null"]},
  "source_split":{"type":["string","null"]},
  "license":{"type":["string","array","null"]},
  "split":{"enum":["train","validation","test","smoke","excluded"]},
  "quality_level":{"type":"string"},
  "quality_tier":{"enum":["locally_recomputed","reference_checked","publisher_verified","publisher_constraints_checked","human_authored","manually_screened","curated_unverified","unverified"]},
  "release_status":{"enum":["eligible","review_required","quarantine","duplicate"]},
  "verification":{"type":"object"},
  "review_flags":{"type":"array","items":{"type":"string"}},
  "provenance":{"type":"array","minItems":1},
  "metadata":{"type":"object"},
  "response_mode":{"enum":["prompt_completion","conversation"]},
  "record_content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
 },
 "additionalProperties":true
}
