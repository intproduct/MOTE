      "kind": "load_from_disk",
      "path": "${CACHE_ROOT}/svamp",
      "split": "train",
      "revision": "REPLACE_WITH_IMMUTABLE_SVAMP_REVISION",
      "minimum_quality_tier": "A"
    },
    {
      "source_name": "synthetic_arithmetic",
      "adapter": "synthetic_arithmetic",
