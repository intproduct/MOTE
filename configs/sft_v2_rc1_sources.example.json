{
  "format": "fitmotn_sft_source_manifest_v1",
  "format_version": "math_raw_v2",
  "max_problem_group_solutions": 2,
  "planned_consumed_sequences": 200000,
  "pretrain_data_plane": {
    "the_stack": {
      "status": "disabled",
      "reason": "single-card rc1 no_code experiment"
    }
  },
  "sources": [
